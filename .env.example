# Copy to .env and fill in your values
# cp .env.example .env

# Your wallet address for on-chain queries
WEB3_WALLET_ADDRESS=0x...

# Infura RPC (optional — falls back to free public RPCs)
INFURA_KEY=
INFURA_POLY_URL=https://polygon-mainnet.infura.io/v3/
INFURA_ETH_URL=https://mainnet.infura.io/v3/
INFURA_BASE_URL=https://base-mainnet.infura.io/v3/

# Dune Analytics (optional — Analyst plan, $65/mo)
DUNE_API_KEY=
